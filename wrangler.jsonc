{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocamap",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // nodejs_compat gives the Worker Node's built-ins (Buffer, crypto, streams),
  // which Next.js needs.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }

  // Hyperdrive 바인딩이 있던 자리다. 데이터베이스를 읽는 코드가 없어졌으니
  // 붙일 것이 없다. Cloudflare 쪽의 Hyperdrive 와 Neon 은 그대로 있다 —
  // 지운 것은 이 설정뿐이고, 돌아가려면 다시 붙이면 된다.
}
