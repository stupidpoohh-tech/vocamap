# --- Database (Neon serverless Postgres, free tier) -------------------------
# Neon dashboard -> Connection string -> "Pooled connection".
# Any standard Postgres URL works (Neon, Supabase, local docker, Railway...).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/vocamap?sslmode=require"
# Direct (non-pooled) URL used only by migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# --- Auth -------------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-openssl-rand-base64-48"

# --- LLM provider (server-side only, never exposed to the browser) ----------
# Supported: anthropic | openai | mock
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-sonnet-4-5"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
