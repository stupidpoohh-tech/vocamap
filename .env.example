# --- Database (Neon serverless Postgres, free tier) -------------------------
# Neon dashboard -> Connection string -> "Pooled connection".
# Any standard Postgres URL works (Neon, Supabase, local docker, Railway...).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/vocamap?sslmode=require"
# Direct (non-pooled) URL used only by migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# --- Auth -------------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-openssl-rand-base64-48"

# --- LLM provider (server-side only, never exposed to the browser) ----------
# Supported: anthropic | openai | mock
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-opus-5"
# Cost/quality dial: low | medium | high | xhigh | max, or "default" to send
# nothing. Thinking tokens bill as output and dominate the cost of one draft,
# so this is the setting that moves the bill.
LLM_EFFORT="medium"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# --- Tests ------------------------------------------------------------------
# Database-backed tests TRUNCATE every table, so they use their own database and
# refuse to run unless its name contains "test". Never point this at dev data.
TEST_DATABASE_URL="postgresql://user:password@host/vocamap_test?sslmode=require"
